# Umgebungsvariablen des TR-Aktienvergleichs – nur Namen und Erläuterungen, keine Werte.
#
# Im Betrieb setzt GitHub Actions diese Werte aus den Repository-Secrets (Settings → Secrets and
# variables → Actions). Für lokale Läufe: Datei als .env kopieren, Werte eintragen und vor dem
# Aufruf laden, z. B.  set -a; . ./.env; set +a
# Die Datei .env ist in .gitignore eingetragen und darf nie eingecheckt werden.

# --- Geheimnisse (nur serverseitig) ---------------------------------------------------------

# Pflicht für produktive Läufe. Verschlüsselt Datenstand, Sicherung und veröffentlichte Daten
# (AES-256-GCM, Schlüssel per PBKDF2 abgeleitet). Dieselbe Passphrase wird einmal auf dem Handy
# eingegeben. Ohne sie bricht `traktien ci` ab, damit nichts unverschlüsselt öffentlich wird.
DATA_PASSPHRASE=

# Optional. Kostenloser Schlüssel von https://www.openfigi.com/api – höheres Abfragelimit bei der
# Zuordnung ISIN → Börsennotierung.
OPENFIGI_API_KEY=

# Optional, kostenpflichtiger Anbieter (nur nach eigener Entscheidung). Wird nur gelesen, wenn
# config/pipeline.yaml → anbieter.kurse: eodhd gesetzt ist oder KURS_ANBIETER=eodhd.
EODHD_API_KEY=

# --- Betrieb --------------------------------------------------------------------------------

# Kursanbieter für einen einzelnen Lauf: yahoo (Standard) oder eodhd. Leer = config/pipeline.yaml.
KURS_ANBIETER=

# INFO (Standard) oder DEBUG. Geheimnisse werden in Protokollen immer geschwärzt.
LOG_LEVEL=

# Nur für Tests: true erlaubt `traktien ci` ohne Passphrase. Nie für die öffentliche Website.
UNVERSCHLUESSELT_ERLAUBT=

# Anderer Konfigurationsordner statt ./config (Tests).
TRAKTIEN_CONFIG_DIR=

# --- Von GitHub Actions gesetzt (lokal nur zum Nachstellen von `traktien ci`) ---------------

# Repository in der Form besitzer/name und ein Token mit Schreibrecht auf Releases.
GITHUB_REPOSITORY=
GITHUB_TOKEN=
# Datei für Ausgaben an die folgenden Workflow-Schritte, Auslöser und Zeitplanausdruck.
GITHUB_OUTPUT=
GITHUB_EVENT_NAME=
AUSLOESENDER_ZEITPLAN=

# --- Tests ----------------------------------------------------------------------------------

# 1 = Tests gegen die echten Datenquellen ausführen (tests/live); Bericht optional als JSON-Datei.
TR_LIVE=
TR_LIVE_REPORT=
# Ordner für Bildschirmfotos der Browser-Tests (tests/e2e).
TR_E2E_SCREENSHOTS=
