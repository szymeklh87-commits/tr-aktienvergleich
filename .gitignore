# Abhängigkeiten und Zwischenstände – werden nie eingecheckt
app/node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# Lokale Läufe, Datenstände und Websites (enthalten Kursdaten bzw. Schlüsselparameter).
# Mit führendem „/“: nur diese Ordner im Hauptverzeichnis, nicht gleichnamige Quellordner
# (z. B. app/src/state).
/build/
/state/
/_site/
/wiederherstellung/
*.sqlite
*.sqlite-wal
*.sqlite-shm
datenquellen-bericht.json

# Geheimnisse gehören in GitHub-Secrets bzw. lokale Umgebungsvariablen, nie ins Repository
.env
.env.*
!.env.example

