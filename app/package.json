{
  "name": "tr-aktienvergleich-app",
  "version": "1.8.0",
  "private": true,
  "description": "Mobile PWA: tägliche historische Ranglisten 1–90 Tage für das TR-Aktienuniversum",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-format": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "d3-time-format": "4.1.0",
    "d3-zoom": "3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/d3-array": "3.2.2",
    "@types/d3-format": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "3.2.0",
    "@types/d3-time-format": "4.0.3",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
